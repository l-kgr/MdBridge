{
  "name": "mdbridge",
  "displayName": "MdBridge",
  "description": "Document converter for document workflows",
  "version": "0.0.1",
  "publisher": "l-kgr",
  "license": "MIT",
  "keywords": [
    "markdown",
    "docx",
    "msg",
    "pptx",
    "converter",
    "outlook",
    "word",
    "proposal"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:mdbridge.msgToMd",
    "onCommand:mdbridge.docxToMd",
    "onCommand:mdbridge.docxToMdWithComments",
    "onCommand:mdbridge.mdToDocx",
    "onCommand:mdbridge.pptxToMd"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdbridge.msgToMd",
        "title": "MdBridge: Convert MSG → Markdown"
      },
      {
        "command": "mdbridge.docxToMd",
        "title": "MdBridge: Convert DOCX → Markdown"
      },
      {
        "command": "mdbridge.docxToMdWithComments",
        "title": "MdBridge: Convert DOCX → Markdown (with comments)"
      },
      {
        "command": "mdbridge.mdToDocx",
        "title": "MdBridge: Export Markdown → DOCX"
      },
      {
        "command": "mdbridge.pptxToMd",
        "title": "MdBridge: Convert PPTX → Markdown"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdbridge.msgToMd",
          "when": "resourceExtname == .msg",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.docxToMd",
          "when": "resourceExtname == .docx",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.docxToMdWithComments",
          "when": "resourceExtname == .docx",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.mdToDocx",
          "when": "resourceExtname == .md",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.pptxToMd",
          "when": "resourceExtname == .pptx",
          "group": "mdbridge"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.22.0",
    "@types/turndown": "^5.0.5",
    "@xmldom/xmldom": "^0.8.10",
    "docx": "^8.5.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.7.2",
    "turndown": "^7.2.0"
  }
}