{
  "name": "mdbridge",
  "displayName": "MdBridge",
  "description": "Document converter for document workflows",
  "version": "0.0.1",
  "publisher": "l-kgr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/l-kgr/MdBridge.git"
  },
  "bugs": {
    "url": "https://github.com/l-kgr/MdBridge/issues"
  },
  "homepage": "https://github.com/l-kgr/MdBridge#readme",
  "keywords": [
    "markdown",
    "docx",
    "odt",
    "odp",
    "odf",
    "libreoffice",
    "msg",
    "pptx",
    "converter",
    "outlook",
    "word",
    "proposal"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:mdbridge.msgToMd",
    "onCommand:mdbridge.docxToMd",
    "onCommand:mdbridge.docxToMdWithComments",
    "onCommand:mdbridge.mdToDocx",
    "onCommand:mdbridge.copyMdAsDocxFormat",
    "onCommand:mdbridge.pptxToMd",
    "onCommand:mdbridge.odtToMd",
    "onCommand:mdbridge.mdToOdt",
    "onCommand:mdbridge.odpToMd"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "MdBridge",
      "properties": {
        "mdbridge.extractMsgAttachments": {
          "type": "boolean",
          "default": false,
          "description": "When converting MSG to Markdown, save attachments to a sibling folder next to the output .md file."
        }
      }
    },
    "commands": [
      {
        "command": "mdbridge.msgToMd",
        "title": "MdBridge: Convert MSG → Markdown"
      },
      {
        "command": "mdbridge.docxToMd",
        "title": "MdBridge: Convert DOCX → Markdown"
      },
      {
        "command": "mdbridge.docxToMdWithComments",
        "title": "MdBridge: Convert DOCX → Markdown (with comments)"
      },
      {
        "command": "mdbridge.mdToDocx",
        "title": "MdBridge: Export Markdown → DOCX"
      },
      {
        "command": "mdbridge.copyMdAsDocxFormat",
        "title": "MdBridge: Copy as DOCX Format"
      },
      {
        "command": "mdbridge.pptxToMd",
        "title": "MdBridge: Convert PPTX → Markdown"
      },
      {
        "command": "mdbridge.odtToMd",
        "title": "MdBridge: Convert ODT → Markdown"
      },
      {
        "command": "mdbridge.mdToOdt",
        "title": "MdBridge: Export Markdown → ODT"
      },
      {
        "command": "mdbridge.odpToMd",
        "title": "MdBridge: Convert ODP → Markdown"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdbridge.msgToMd",
          "when": "resourceExtname == .msg",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.docxToMd",
          "when": "resourceExtname == .docx",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.docxToMdWithComments",
          "when": "resourceExtname == .docx",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.mdToDocx",
          "when": "resourceExtname == .md",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.mdToOdt",
          "when": "resourceExtname == .md",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.copyMdAsDocxFormat",
          "when": "resourceExtname == .md",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.pptxToMd",
          "when": "resourceExtname == .pptx",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.odtToMd",
          "when": "resourceExtname == .odt",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.odpToMd",
          "when": "resourceExtname == .odp",
          "group": "mdbridge"
        }
      ],
      "editor/context": [
        {
          "command": "mdbridge.mdToDocx",
          "when": "resourceExtname == .md",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.mdToOdt",
          "when": "resourceExtname == .md",
          "group": "mdbridge"
        },
        {
          "command": "mdbridge.copyMdAsDocxFormat",
          "when": "resourceExtname == .md",
          "group": "mdbridge"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.22.0",
    "@types/turndown": "^5.0.5",
    "@xmldom/xmldom": "^0.8.10",
    "docx": "^8.5.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.7.2",
    "turndown": "^7.2.0"
  }
}