{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mdbridge: compile",
      "type": "npm",
      "script": "compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "mdbridge: watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "group": "build",
      "problemMatcher": {
        "owner": "webpack",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiler starting",
          "endsPattern": "compiled successfully|Failed to compile"
        }
      },
      "presentation": {
        "reveal": "never"
      }
    }
  ]
}
